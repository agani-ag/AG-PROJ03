# Copy to .env and fill in. .env is gitignored.

# What the sidebar, page titles and sign-in page call this product.
APP_NAME=SyncHub

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
# Any host name is accepted, as in AG-PROJ01 and AG-PROJ02.
ALLOWED_HOSTS=*
# Leave this EMPTY. Django refuses to start if it contains "*" (error 4_0.E001) — entries must
# carry a scheme. Empty is already correct for any domain: Django compares the Origin against the
# request's own host, so normal sign-ins and form posts work wherever the site is hosted. Only fill
# it in if some OTHER domain has to post into this one, e.g. CSRF_TRUSTED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=

# The one admin account, created by: python manage.py createadminuser
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin
# Optional 5-character sign-in PIN (A-Z, 0-9), used by the PIN tab on the sign-in page
ADMIN_PIN=AG222

# Shared secret for the two cron URLs (/cron/tick, /cron/cleanup). Unset = endpoints closed.
CRON_KEY=

# Needed for notifications: where SyncUp lives, and its partner notify key.
# These are also editable on the Hibiscus settings page.
