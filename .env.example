# Copy to .env and fill in. .env is gitignored.

# What the sidebar, page titles and sign-in page call this product.
APP_NAME=SyncHub

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=*
# Needed in production behind https, e.g. https://app.example.com
CSRF_TRUSTED_ORIGINS=

# The one admin account, created by: python manage.py createadminuser
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin
# Optional 5-character sign-in PIN (A-Z, 0-9), used by the PIN tab on the sign-in page
ADMIN_PIN=AG222
